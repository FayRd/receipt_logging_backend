# =============================================================================
# receipt_logging_backend — Environment Configuration Template
# Copy this file to .env and fill in the required values.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Redis (required)
# ---------------------------------------------------------------------------
REDIS_CONNECTION_STRING=redis://localhost:6379

# ---------------------------------------------------------------------------
# AI Provider Selection
# ---------------------------------------------------------------------------
# Set AI_PROVIDER to either "gemini" (default) or "openrouter".
# Fallback: if AI_PROVIDER is omitted but only OPENROUTER_API_KEY is set,
# OpenRouter is automatically used.
AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Google GenAI (Gemini) — used when AI_PROVIDER=gemini
# Obtain key at: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Vision model for bulk scan receipt parsing
# Recommended: gemini-3.6-flash, gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# Chat model for AI financial assistant & RAG
# Recommended: gemini-3.6-flash, gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# OpenRouter — used when AI_PROVIDER=openrouter
# Obtain key at: https://openrouter.ai/keys
# Model catalogue: https://openrouter.ai/models
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vision model for bulk scan receipt parsing (must support image input)
# Examples: google/gemini-2.5-flash, openai/gpt-4o, anthropic/claude-3.5-haiku
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Chat model for AI financial assistant & RAG (vision not required)
# Examples: google/gemini-2.5-flash, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash

# ---------------------------------------------------------------------------
# Optional: Logfire observability
# ---------------------------------------------------------------------------
LOGFIRE_TOKEN=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8085"]

# ---------------------------------------------------------------------------
# Rate Limiting (all values per minute per IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCAN_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CRUD_PER_MINUTE=60
RATE_LIMIT_HEALTH_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Scanning & AI Vision
# ---------------------------------------------------------------------------
MAX_IMAGE_SIZE_BYTES=10485760   # 10 MB
CONFIDENCE_THRESHOLD=0.8        # Receipts below this score are rejected

# ---------------------------------------------------------------------------
# AI Chat & RAG
# ---------------------------------------------------------------------------
RAG_RECENT_RECEIPTS_LIMIT=100
RAG_HISTORY_MESSAGES_LIMIT=50
MAX_CONVERSATIONS_PER_IDENTITY=10

# ---------------------------------------------------------------------------
# SSE Batch Stream
# ---------------------------------------------------------------------------
SSE_POLL_INTERVAL_SECONDS=1.0
SSE_BATCH_TIMEOUT_SECONDS=300
REDIS_JOB_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
ENABLE_FILE_LOGGING=true
LOG_FILE_PATH=app.log
LOG_LEVEL=DEBUG
ENABLE_CONSOLE_LOGGING=true