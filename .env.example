# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Redis Connection (Format: redis://:[password]@[host]:[port]/[db])
REDIS_CONNECTION_STRING=redis://localhost:6379

# Google Gemini Vision & RAG AI Key
GEMINI_API_KEY=your-gemini-api-key

# Server Environment & CORS Settings
ENVIRONMENT=development
ALLOWED_ORIGINS=["*"]

# SSE Bulk Batch Stream Settings (Optional - defaults to 1.0s and 300s)
SSE_POLL_INTERVAL_SECONDS=1.0
SSE_BATCH_TIMEOUT_SECONDS=300

# OpenTelemetry / Jaeger Local Exporter Endpoint (for local dashboard)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318