# =============================================================================
# receipt_logging_backend — Environment Configuration Template
# Copy this file to .env and fill in the required values.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Redis (required)
# ---------------------------------------------------------------------------
REDIS_CONNECTION_STRING=redis://localhost:6379

# ---------------------------------------------------------------------------
# AI Provider Selection
# ---------------------------------------------------------------------------
# Set AI_PROVIDER to either "gemini" (default) or "openrouter".
# Fallback: if AI_PROVIDER is omitted but only OPENROUTER_API_KEY is set,
# OpenRouter is automatically used.
AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Google GenAI (Gemini) — used when AI_PROVIDER=gemini
# Obtain key at: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Vision model for bulk scan receipt parsing
# Recommended: gemini-3.6-flash, gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# Chat model for AI financial assistant & RAG
# Recommended: gemini-3.6-flash, gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# OpenRouter — used when AI_PROVIDER=openrouter
# Obtain key at: https://openrouter.ai/keys
# Model catalogue: https://openrouter.ai/models
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vision model for bulk scan receipt parsing (must support image input)
# Examples: google/gemini-2.5-flash, openai/gpt-4o, anthropic/claude-3.5-haiku
OPENROUTER_VISION_MODEL=
OPENROUTER_VISION_MODEL_FREE=

# Chat model for AI financial assistant & RAG (vision not required)
# Examples: google/gemini-2.5-flash, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
OPENROUTER_CHAT_MODEL=
OPENROUTER_CHAT_MODEL_FREE=

# ---------------------------------------------------------------------------
# Optional: Logfire observability
# ---------------------------------------------------------------------------
LOGFIRE_TOKEN=

# ---------------------------------------------------------------------------
# Application & Container Deployment
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=sancfund-backend
CONTAINER_NAME=sancfund-backend
JAEGER_CONTAINER_NAME=jaeger_dashboard
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
PORT=8085
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8085"]

# ---------------------------------------------------------------------------
# Rate Limiting (all values per minute per IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCAN_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CRUD_PER_MINUTE=60
RATE_LIMIT_HEALTH_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Scanning & AI Vision
# ---------------------------------------------------------------------------
MAX_IMAGE_SIZE_BYTES=10485760   # 10 MB
CONFIDENCE_THRESHOLD=0.8        # Receipts below this score are rejected

# ---------------------------------------------------------------------------
# AI Chat & RAG
# ---------------------------------------------------------------------------
RAG_RECENT_RECEIPTS_LIMIT=100
RAG_HISTORY_MESSAGES_LIMIT=50
MAX_CONVERSATIONS_PER_IDENTITY=10

# ---------------------------------------------------------------------------
# SSE Batch Stream
# ---------------------------------------------------------------------------
SSE_POLL_INTERVAL_SECONDS=1.0
SSE_BATCH_TIMEOUT_SECONDS=300
REDIS_JOB_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
ENABLE_FILE_LOGGING=true
LOG_FILE_PATH=app.log
LOG_LEVEL=DEBUG
ENABLE_CONSOLE_LOGGING=true

# ---------------------------------------------------------------------------
# Discord Webhooks
# ---------------------------------------------------------------------------
DISCORD_FEEDBACK_WEBHOOK_URL=DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---------------------------------------------------------------------------
# MailTrap Configurations
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@taskcollab.local"
MAIL_FROM_NAME="SancFund"

# ---------------------------------------------------------------------------
# Security Configurations (Required for Staging & Production)
# Reference: OWASP Key Management Cheat Sheet
# ---------------------------------------------------------------------------
# DATA_ENCRYPTION_KEY: 256-bit AES-GCM data-at-rest encryption key.
# Must be exactly 32 bytes (256 bits), Base64-encoded.
# Generate via OS CSPRNG:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# NEVER use development placeholder keys in staging or production.
DATA_ENCRYPTION_KEY=

# JWT_SECRET_KEY: High-entropy secret key for signing & verifying JWT tokens.
# Must be at least 32 characters long.
# Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER use development placeholder keys in staging or production.
JWT_SECRET_KEY=